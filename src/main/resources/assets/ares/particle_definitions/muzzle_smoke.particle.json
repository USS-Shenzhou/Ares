{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ares:muzzle_smoke",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "ares:particle/muzzle_smoke"
			}
		},
		"components": {
			"sbm:fp_emitter_local_space": {
				"position": false,
				"rotation": false,
				"to_world": false
			},
			"minecraft:emitter_local_space": {
				"position": false,
				"rotation": false
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 4
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.05
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, 0, 0],
				"direction": [0, 0, -1]
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "variable.size = (0.25 + 0.35 * variable.particle_age / variable.particle_lifetime) * (0.8 + 0.4 * variable.particle_random_2);"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.4, 0.8)"
			},
			"minecraft:particle_initial_speed": ["math.random(-0.4, 0.4)", "math.random(0.2, 0.6)", "math.random(-1.5, -0.6)"],
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0, 360)",
				"rotation_rate": "math.random(-40, 40)"
			},
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 0.6, 0],
				"linear_drag_coefficient": 3
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.size", "variable.size"],
				"facing_camera_mode": "rotate_xyz"
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#80D8D8D8",
						"0.3": "#60AAAAAA",
						"1.0": "#00666666"
					}
				}
			}
		}
	}
}
